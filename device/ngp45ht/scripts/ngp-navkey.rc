# NGP45HT: 机身 M 键 / 返回键的多击与长按守护。
#
# keylayout 把 M/返回都映射成 UNKNOWN，本服务读原始 KEY_MUTE/KEY_ESC：
#   M 键      单击 HOME / 双击无动作 / 长按 MENU
#   返回键    单击 BACK / 双击无动作 / 长按终止前台应用
#
# 监听 /dev/input/event2 (adc-keys-ngp)。该节点不会被 gammapad re-hid，
# event 号稳定，不像物理手柄那样会消失。
service ngp_navkey /vendor/bin/ngp-navkey.sh
    class late_start
    user root
    group root shell
    seclabel u:r:shell:s0

on property:sys.boot_completed=1
    start ngp_navkey

# getevent 偶尔会因输入设备重新注册而退出，掉了就拉起来
on property:init.svc.ngp_navkey=stopped
    start ngp_navkey
