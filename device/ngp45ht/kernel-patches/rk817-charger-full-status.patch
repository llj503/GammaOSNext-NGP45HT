diff --git a/drivers/power/supply/rk817_charger.c b/drivers/power/supply/rk817_charger.c
index b7e4f7627..f6afaab83 100644
--- a/drivers/power/supply/rk817_charger.c
+++ b/drivers/power/supply/rk817_charger.c
@@ -349,6 +349,12 @@ static enum power_supply_property rk817_usb_props[] = {
 	POWER_SUPPLY_PROP_CURRENT_MAX,
 };
 
+/*
+ * NGP45HT fix（2026-11-05）前置声明：这两个 get_property 是文件里最早的调用点，
+ * 函数实体却定义在后面，所以声明必须放在这里。
+ */
+static int rk817_charge_report_status(struct rk817_charger *charge);
+
 static int rk817_charge_ac_get_property(struct power_supply *psy,
 					enum power_supply_property psp,
 					union power_supply_propval *val)
@@ -369,7 +375,7 @@ static int rk817_charge_ac_get_property(struct power_supply *psy,
 		if (charge->pdata->virtual_power)
 			val->intval = POWER_SUPPLY_STATUS_CHARGING;
 		else
-			val->intval = charge->prop_status;
+			val->intval = rk817_charge_report_status(charge);
 
 		DBG("report prop: %d\n", val->intval);
 		break;
@@ -407,7 +413,7 @@ static int rk817_charge_usb_get_property(struct power_supply *psy,
 		if (charge->pdata->virtual_power)
 			val->intval = POWER_SUPPLY_STATUS_CHARGING;
 		else
-			val->intval = charge->prop_status;
+			val->intval = rk817_charge_report_status(charge);
 
 		DBG("report prop: %d\n", val->intval);
 		break;
@@ -563,6 +569,42 @@ static void rk817_charge_sys_can_sd_disable(struct rk817_charger *charge)
 	rk817_charge_field_write(charge, SYS_CAN_SD, DISABLE);
 }
 
+static int rk817_charge_get_charge_status(struct rk817_charger *charge);
+static int rk817_charge_get_dsoc(struct rk817_charger *charge);
+static int rk817_charge_online(struct rk817_charger *charge);
+
+/*
+ * NGP45HT fix（2026-11-05）：ac / usb 的 status 一直报「正在充电」，而 battery
+ * 已经报 Full —— 下拉通知栏的充电提示永远不消失。
+ *
+ * 根因：prop_status 只在 set_chrg_param() 里被赋值，也就是**只在插拔事件
+ * 发生时刷新**。电池从 CC 充到 CHRG_TERM 的这个过程不会触发 set_chrg_param，
+ * 所以 prop_status 一直停在插电那一刻的 CHARGING。battery 那边则是实时算
+ * 的（dsoc==100 -> FULL），两边必然分叉。
+ *
+ * 修法：在 get_property 路径上实时判定。CHG_STS == CHRG_TERM 是硬件给出的
+ * 「充电终止」结论，比容量值可靠；容量满作为兜底。
+ */
+static int rk817_charge_report_status(struct rk817_charger *charge)
+{
+	/*
+	 * 只在确实有外接电源时才改判，否则会把 set_chrg_param() 写的
+	 * DISCHARGING 覆盖掉。
+	 */
+	if (!rk817_charge_online(charge))
+		return charge->prop_status;
+
+	/*
+	 * rk817_charge_get_dsoc() 返回 0..100 的百分比。
+	 * 用 >= 99 做兜底，覆盖 fuel gauge 卡在 99 的情况。
+	 */
+	if (rk817_charge_get_charge_status(charge) == CHRG_TERM ||
+	    rk817_charge_get_dsoc(charge) >= 99)
+		charge->prop_status = POWER_SUPPLY_STATUS_FULL;
+
+	return charge->prop_status;
+}
+
 static int rk817_charge_get_charge_status(struct rk817_charger *charge)
 {
 	int status;
@@ -1277,9 +1319,33 @@ static int rk817_charge_usb_init(struct rk817_charger *charge)
 		}
 
 		charge->usb_charger = charger;
-		if (charge->dc_charger != DC_TYPE_NONE_CHARGER)
-			rk817_charge_set_chrg_param(charge,
-						    charge->usb_charger);
+
+		/*
+		 * NGP45HT fix: 原来这里是
+		 *     if (charge->dc_charger != DC_TYPE_NONE_CHARGER)
+		 *             rk817_charge_set_chrg_param(charge, charge->usb_charger);
+		 *
+		 * 即「只有 DC 口插着充电器才把 USB 类型落到 ac_in/usb_in」。
+		 * 这块板子没有 DC 口，GPIO3_A7 恒为低，dc_charger 永远是
+		 * DC_TYPE_NONE_CHARGER，于是这个 if 永远为假 —— usb_in 从头
+		 * 到尾保持结构体初值。
+		 *
+		 * 后果不是「没插充电器时不报充电」，而是更糟：它到底是初值还是
+		 * SDP 探测结果，完全取决于编译器把零初始化放在哪，实测这台机器
+		 * 上落成了 1。于是电源管理那边一直以为插着充电器（电池图标带
+		 * 闪电、状态灯常亮），而 rk817 芯片自己算出来 CHG_STS=0、电流
+		 * 是负的（真的在放电）。软件状态和硬件状态从此对不上。
+		 *
+		 * 而 dc_det 中断解决不了这件事：GPIO3_A7 一直是低电平，没有边沿
+		 * 就没有中断，/proc/interrupts 里 rk817_dc_det 计数恒为 0，
+		 * 那个能在 PLUG_IN_STS=0 时把 usb_in 清零的 worker 永远不会跑。
+		 *
+		 * 所以这里必须无条件调用。set_chrg_param() 内部自己会看 dc_in：
+		 *   - 有 DC  -> 走 DC_TYPE_DC_CHARGER 分支，保持现状
+		 *   - 无 DC  -> 在 !PLUG_IN_STS 时把 ac_in/usb_in 一起清零
+		 * 也就是说原代码担心的「USB 覆盖掉 DC 判定」根本不会发生。
+		 */
+		rk817_charge_set_chrg_param(charge, charge->usb_charger);
 
 		DBG("register bc evt notifier\n");
 	}
