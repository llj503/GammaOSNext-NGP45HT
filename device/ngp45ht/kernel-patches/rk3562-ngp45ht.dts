	];
};

/* 1024x768 at ~60 Hz, taken from the stock timing0 node. */
&dsi_timing0 {
	clock-frequency = <52134144>;
	hactive = <1024>;
	vactive = <768>;
	hfront-porch = <32>;
	hsync-len = <20>;
	hback-porch = <20>;
	vfront-porch = <8>;
	vsync-len = <4>;
	vback-porch = <6>;
	hsync-active = <0>;
	vsync-active = <0>;
	de-active = <0>;
	pixelclk-active = <0>;
};

/* ---- Audio --------------------------------------------------------------- */

/* Amplifier enable is the codec's own pin on this board. */
&rk817_codec {
	use-ext-amplifier;
	spk-ctl-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_HIGH>;
	hp-volume = <15>;
	spk-volume = <6>;
};

/* Headphone detect moved from RK_PA7 (shared default) to RK_PA6. */
&rk817_sound {
	hp-det-gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&hp_det>;
	/delete-property/ spk-con-gpios;

	/*
	 * The shared dtsi polls SARADC0 input 4 as a headphone/insertion
	 * detector and hangs a play-pause key off it at a 2 mV threshold.  This
	 * board leaves that input unconnected, so the floating reading reports
	 * phantom KEY_PLAYPAUSE events; drop the whole ladder.
	 */
	/delete-property/ io-channels;
	/delete-property/ io-channel-names;
	/delete-property/ keyup-threshold-microvolt;
	/delete-property/ poll-interval;
	/delete-node/ play-pause-key;
};

/* ---- Power, battery and charge indication ------------------------------- */

&rk817 {
	battery {
		compatible = "rk817,battery";
		/*
		 * 21-point OCV table in mV, from the vendor tree.  Monotonic by
		 * construction -- rk817_bat_vol_to_soc() walks it with a binary
		 * search, so a non-sorted table silently returns wrong SoC.
		 */
		ocv_table = <3500 3539 3608 3694 3767 3806 3829 3844 3856 3863 3869 3882 3930 4003 4010 4023 4033 4045 4059 4070 4171>;
		design_capacity = <3791>;
		design_qmax = <4000>;
		design_max_voltage = <4120>;
		sleep_enter_current = <150>;
		sleep_exit_current = <180>;
		sleep_filter_current = <100>;
		power_off_thresd = <3450>;
		zero_algorithm_vol = <3950>;
		max_soc_offset = <60>;
		monitor_sec = <5>;

		/*
		 * sample_res is the current-sense resistor value in 10 mOhm
		 * units: 10 => 100 mOhm.  Getting this wrong scales current_now
		 * (and therefore everything derived from it) by 2x or 0.5x.
		 */
		sample_res = <10>;

		/*
		 * bat_res: 电池内阻，单位 mOhm，直接参与 SoC 换算：
		 *     ocv_voltage = voltage_avg - (current_avg * bat_res) / 1000
		 * 驱动拿它把带载的端电压回算成开路电压，再去查 ocv_table。
		 *
		 * 缺这一项时驱动回落到 DEFAULT_BAT_RES = 135 mOhm。本机典型
		 * 放电电流约 480 mA，135 与 127 差 8 mOhm 只值 ~4 mV，不大；
		 * 真正的问题在 next 一条注释里说的 SoC 归零算法。
		 *
		 * 127 取自原厂 EmuELEC 的 rk3562-ngp45ht.dtb（0x7f）。
		 * 之前自估的 80 已按「以 EE 为准」的要求改掉。
		 */
		bat_res = <127>;

		/*
		 * energy_mode 0 = report SoC straight from the OCV lookup.
		 * Mode 1 lets the driver slow the gauge down near empty so the
		 * last few percent last longer, which trades accuracy for
		 * runtime -- wrong call for a handheld whose whole point is a
		 * trustworthy number on screen.
		 */
		energy_mode = <0>;

		/*
		 * Reserve SoC kept back once the "zero algorithm" fires, in
		 * whole percent (driver multiplies by 1000).  The vendor value
		 * for this pack is 10.
		 */
		zero_reserve_dsoc = <10>;

		/*
		 * fb_temperature is the "flat" temperature in degrees C that the
		 * driver substitutes when the NTC reads outside its valid window;
		 * 25 keeps a nonsense reading from pinning the charger.
		 */
		fb_temperature = <25>;

		virtual_power = <0>;
		dc_det_gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;

		/*
		 * 这三个属性只是名字占位，5.10 的 rk817_battery.c /
		 * rk817_charger.c 完全不解析它们（全树 grep 过，除 DTS 外零引用），
		 * rk817 芯片本身也没有"按 CHG_STS 点灯"的硬件逻辑。
		 *
		 * 真正的驱动在下面的 ngp-status-led 节点（leds-gpio），
		 * 用户态 ngp-powerled 按充电状态去点。
		 *
		 * 历史教训（别走回头路）：
		 *   1) 早先这里挂了 pinctrl-0 = <&ngp_charge_led_gpio>，那组 pin
		 *      是 RK_FUNC_GPIO + pcfg_pull_up，等于把 C1(蓝)/C2(红) 内部
		 *      上拉。两根线被持续拉高 -> 状态灯一直亮，息屏也不灭。
		 *      这就是「电源灯充电灯长期亮着」的直接原因。
		 *   2) 把 pinctrl 整组删掉之后走另一个极端：引脚浮空、无人驱动，
		 *      充电中红灯也不亮（2026-11-04 实测确认）。
		 *
		 * 实测引脚语义（syskbd gpio 直接拉电平验证）：
		 *   GPIO3_C1 (gpio-113) 高电平 -> 蓝灯亮
		 *   GPIO3_C2 (gpio-114) 高电平 -> 红灯亮
		 *   GPIO3_C3 (gpio-115) 无可见效果（未贴片或另有用途）
		 */
		charge_blue_gpio = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		charge_red_gpio = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
		charge_display_gpio = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
	};

	charger {
		compatible = "rk817,charger";

		/*
		 * 下面四个数值和原厂 EmuELEC 的 DTS 完全一致：
		 *   4500 = 0x1194  min_input_voltage
		 *   2500 = 0x09c4  max_input_current / max_chrg_current
		 *   4350 = 0x10fe  max_chrg_voltage
		 *    300 = 0x012c  chrg_finish_cur
		 * 改之前请先对一遍 EE 那份，别凭手感调。
		 */
		min_input_voltage = <4500>;
		max_input_current = <2500>;
		max_chrg_current = <2500>;
		max_chrg_voltage = <4350>;
		chrg_term_mode = <0>;
		chrg_finish_cur = <300>;
		virtual_power = <0>;

		/*
		 * sample_res / power_dc2otg / otg5v_suspend_enable 这三项 EE
		 * 没写，但驱动在缺项时会：
		 *   sample_res        -> SAMPLE_RES_10MR (10)   与这里同值
		 *   power_dc2otg      -> 0                     与这里同值
		 *   otg5v_suspend_enable -> 1                   与这里同值
		 * 即行为等价。保留显式声明，只为避免 DTS 缺项时驱动打 dev_err
		 * 把启动日志刷花。
		 */

		/* Same 10 x 10 mOhm sense resistor as the battery gauge. */
		sample_res = <10>;

		/*
		 * power_dc2otg: 0.  When set, the DC input path is allowed to
		 * feed the OTG 5 V rail while USB is in host mode.  This board
		 * powers its OTG port from a dedicated vcc5v0-usb-otg switch, so
		 * letting the charger duplicate that would fight the regulator.
		 */
		power_dc2otg = <0>;

		dc_det_adc = <0>;
		dc_det_gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		otg5v_suspend_enable = <1>;
		extcon = <&u2phy>;
		gate_function_disable = <1>;
	};
};

&charge_anim {
	rockchip,uboot-low-power-voltage = <3350>;
	rockchip,screen-on-voltage = <3400>;
};

/* ---- Bring-up of peripherals this board does not have on those pins ----- */

/* Four-key SARADC ladder replaces the shared dtsi's two-key one. */
&adc_keys {
	status = "disabled";
};

/*
 * WiFi is USB-attached, so the SDIO WiFi stack from the shared dtsi must not
 * claim PB3 (a gamepad button here), PB4 (button), PA6 (headphone detect) or
 * sdmmc1.
 */
/*
 * Second TF slot.  sdmmc1 (ff890000) is wired to a removable card on this
 * board, not to an SDIO WiFi combo module -- the wireless chip is the USB
 * AIC8800DC -- so it becomes /dev/mmcblk2, which is exactly the node
 * /usr/local/bin/Switch to SD2 for Roms.sh expects on non-RK3326 hardware.
 *
 * Pin set taken from the vendor tree: bus4 = GPIO1_C1..C4, cmd = C5,
 * clk = C6, det = PD0, matching the kernel's plain sdmmc1_* groups.
 *
 * UHS is deliberately not requested.  Both slots share one I/O rail
 * (vccio_sd / RK817 LDO_REG5), so it cannot be switched to 1.8 V for one card
 * while the other stays at 3.3 V; the vendor DT's sd-uhs-sdr104 looks
 * inherited from the EVB reference.  High-speed 50 MHz is plenty for ROMs.
 *
 * Card detect: this slot's CDETECT pad reads "absent" even with a 128 GiB
 * card inserted, so broken-cd is kept to make the core poll at all.
 *
 * SD2 does not come up on this port and the reason is not in this node.
 * Measured: with the node reduced to exactly the vendor's working one --
 * same vqmmc (LDO_REG5), same bus4/cmd/clk/det groups (confirmed in
 * pinmux-pins), same clocks/resets, sd-uhs-sdr104 and the 200 MHz ceiling
 * -- the host still runs the 400/300/200/100 kHz probe ladder and gets no
 * OCR response, while stock EmuELEC on kernel 6.1 reads the same card as
 * "mmc2: new high speed SDXC".  UHS stays off here because vccio_sd is
 * shared with TF1, which hosts the root filesystem.
 */
&sdmmc1 {
	/delete-property/ no-sd;
	/delete-property/ mmc-pwrseq;
	/delete-property/ cap-sdio-irq;
	/delete-property/ keep-power-in-suspend;
	/delete-property/ supports-sdio;
	/delete-property/ supports-rk912;
	/delete-property/ sd-uhs-sdr104;

	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-mmc-highspeed;
	disable-wp;
	broken-cd;
	max-frequency = <50000000>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk &sdmmc1_det>;
	status = "okay";
};

&sdio_pwrseq {
	status = "disabled";
};

&wireless_wlan {
	status = "disabled";
};

/*
 * The stick-LED MCU UART would take PD2, which is a gamepad button.
 *
 * This board's RGB rings are NOT on UART1 -- they are WS2812 chains on SPI0
 * (see &spi0 at the bottom of this file).  The RG52 Mini / RG43H Pro use a
 * byte-oriented MCU on uart1 instead; copying that over to this board was
 * wrong and produced a dead port plus a stolen button.  Keep it off.
 */
&uart1 {
	status = "disabled";
};

/* ---- HDMI out: RK628D RGB-to-HDMI bridge on i2c3 ---------------------- *
 *
 * This board does have a physical HDMI socket, but RK3562 has no native
 * HDMI transmitter (rk3562.dtsi contains no dw-hdmi node, and the VOP only
 * exposes vp0 -> rgb / dsi / lvds).  What the socket is wired to is an
 * RK628D bridge: VOP -> parallel RGB -> RK628D -> HDMI.
 *
 * The shared rk3562-darkos.dtsi puts that bridge on i2c4 at 0x50, which is
 * where the RG52 Mini / RG43H Pro have it.  On this board it is on i2c3
 * instead: i2cdetect on the running system shows i2c-4 completely empty
 * while the stock firmware's own device tree names
 * "/i2c@ffa20000/rk628@50" (i2c3 = 0xffa20000).  Everything below is taken
 * from that stock tree, converted out of its phandle form:
 *
 *   enable-gpios  = <&gpio3 14 0>  -> GPIO3_B6, active high
 *   reset-gpios   = <&gpio3 10 1>  -> GPIO3_B2, active low
 *   interrupts    = <11 4> on gpio3-> GPIO3_B3, level high
 *   pinctrl-0     = rk628-reset (gpio3 B2) + refclk-pins (gpio0 A0 func1)
 *
 * None of these three lines collide with anything else here: the 17 gamepad
 * buttons use gpio1 D1..D4/C7, gpio2 A0/A1, gpio0 A5/B3..B7/C3/C5..C7 and
 * gpio3 A6; USB host 5V is gpio3 C0 / B0.  The charging LEDs are gpio3
 * A7 (dc_det), C1 (blue), C2 (red) and C3 (display) and match the stock
 * tree exactly, so they are not in the way either.
 *
 * Note the shared dtsi's own values (gpio3 C0 enable / C1 reset / C2 irq)
 * are wrong for this board -- C1 is the blue charge LED and C2 the red one.
 */
&i2c3 {
	status = "okay";
	clock-frequency = <400000>;

	rk628: rk628@50 {
		status = "okay";
		compatible = "rockchip,rk628";
		reg = <0x50>;
		#sound-dai-cells = <0>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PB3 IRQ_TYPE_LEVEL_HIGH>;
		enable-gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&ngp_rk628_reset &ngp_rk628_refclk>;
		assigned-clocks = <&cru CLK_PMU1_WIFI>;
		assigned-clock-rates = <24000000>;
		clocks = <&cru CLK_PMU1_WIFI>;
		clock-names = "soc_24M";
		mode-sync-pol = <0>;
		rk628-rgb-in;
		rk628-hdmi-out;

		port {
			/*
			 * Cannot reuse the dtsi's "rgb_in_hdmi" label: that one
			 * still exists on the (now disabled) i2c4 node and DTC
			 * rejects duplicate labels.  The RGB side below is
			 * patched by absolute path instead, and the dtsi's i2c4
			 * node is disabled so nothing else points at it.
			 */
			ngp_rgb_in_hdmi: endpoint {
				remote-endpoint = <&rgb_out_hdmi>;
			};
		};
	};
};

/* The dtsi's rk628 node on i2c4 must not probe: on this board i2c4 is bare,
 * and its GPIO assignments would fight the charge LEDs. */
&i2c4_rk628 {
	status = "disabled";
};

/*
 * Disable the i2c4 controller itself, not just the bridge underneath it.
 * i2c4m0-xfer claims GPIO3_B6/GPIO3_B7 as its SDA/SCL, and GPIO3_B6 is the
 * RK628 enable line.  Leaving the bus enabled leaves those pins muxed to i2c
 * and the bridge never gets powered -- identical symptom to a board fault.
 */
&i2c4 {
	status = "disabled";
};

/*
 * HDMI audio: SAI2 -> RK628 over I2S.  The card node itself (rk628_sound)
 * comes from the shared dtsi and points at &i2c4_rk628, which is disabled
 * here, so retarget the codec at the live node on i2c3.
 *
 * The CPU DAI has to be brought up separately, and it is SAI2 (ff820000),
 * not SAI1 -- the stock firmware also leaves SAI1 disabled.  Everything
 * that touches &sai2 belongs in one place because the pin list matters:
 * the dtsi's default pinctrl-0 also claims i2s2m0_sdi on GPIO2_A0, and on
 * this board GPIO2_A0 is a gamepad button.  HDMI only carries audio out, so
 * drop SDI and keep LRCK / SCLK / SDO -- same three groups the stock DTB
 * uses (GPIO1_D6, GPIO1_D5, GPIO1_D7).
 */
&sai2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s2m0_lrck &i2s2m0_sclk &i2s2m0_sdo>;
};

&rk628_sound {
	status = "okay";

	/*
	 * The dtsi hard-codes &sai1 as the CPU DAI, but SAI1 is disabled on this
	 * board (the stock firmware leaves it disabled too), so the card never
	 * binds and /proc/asound/cards stays empty with no error in the log.
	 * The bridge is wired to SAI2 instead.
	 */
	simple-audio-card,cpu {
		sound-dai = <&sai2>;
	};

	simple-audio-card,codec {
		sound-dai = <&rk628>;
	};
};

/*
 * Parallel RGB output that feeds the bridge.
 *
 * The 24-bit RGB bus plus the sync/clock lines must be muxed to their VO
 * alternate function, otherwise the pins stay on their GPIO default and the
 * bridge sees no signal at all -- which looks exactly like "the chip is not
 * powered", because rk628_probe() then cannot reach the HDMI register window.
 * Pin list is the one the stock firmware uses (pinctrl "vo-pins").
 */
&rgb {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&ngp_vo_pins>;

	ports {
		port@0 {
			rgb_in_vp0: endpoint@0 {
				status = "okay";
			};
		};

		port@1 {
			rgb_out_hdmi: endpoint {
				remote-endpoint = <&ngp_rgb_in_hdmi>;
			};
		};
	};
};

&route_rgb {
	status = "okay";
	connect = <&vp0_out_rgb>;
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/*
 * SD-card power is a fixed rail on this board.  The shared dtsi drives it
 * from GPIO0_A5, which is a gamepad button here, so make the regulator
 * always-on and drop its GPIO.  Likewise the LED rail's GPIO0_C7 is a button.
 */
&vcc_sd {
	compatible = "regulator-fixed";
	regulator-always-on;
	regulator-boot-on;
	/delete-property/ gpios;
	/delete-property/ enable-active-low;
	/delete-property/ states;
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;
};

/*
 * The stick-LED rail is gated by GPIO0_C7 on the AISLPC boards, which is a
 * gamepad button here, so the rail goes away entirely rather than being
 * re-parented.
 */
&led_vcc {
	status = "disabled";
	/delete-property/ gpios;
	/delete-property/ enable-active-high;
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;
};

/* ---- Pin control -------------------------------------------------------- */

&pinctrl {
	/*
	 * RK628D HDMI bridge pins, straight from the stock tree's own rk628
	 * pinctrl group: reset on GPIO3_B2 (func0 = GPIO), and a 24 MHz
	 * reference clock generated on GPIO0_A0 (func1 = CLK_PMU1_WIFI).
	 * The enable line GPIO3_B6 needs no pinmux entry, it is plain GPIO.
	 */
	rk628 {
		ngp_rk628_reset: ngp-rk628-reset {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		ngp_rk628_refclk: ngp-rk628-refclk {
			rockchip,pins = <0 RK_PA0 1 &pcfg_pull_none>;
		};
	};

	/*
	 * VO (video output) pinmux for the parallel RGB bus feeding RK628D.
	 * Copied pin-for-pin from the stock firmware's "vo-pins" group -- 28
	 * entries, all function 1, no pulls.  Without this the RGB pins keep
	 * their reset default and the bridge receives nothing.
	 */
	vo {
		ngp_vo_pins: ngp-vo-pins {
			rockchip,pins =
				<4 RK_PB7 1 &pcfg_pull_none>,
				<4 RK_PA4 1 &pcfg_pull_none>,
				<4 RK_PA5 1 &pcfg_pull_none>,
				<4 RK_PB2 1 &pcfg_pull_none>,
				<3 RK_PC4 1 &pcfg_pull_none>,
				<3 RK_PC5 1 &pcfg_pull_none>,
				<3 RK_PC6 1 &pcfg_pull_none>,
				<3 RK_PC7 1 &pcfg_pull_none>,
				<3 RK_PD0 1 &pcfg_pull_none>,
				<4 RK_PA6 1 &pcfg_pull_none>,
				<4 RK_PA7 1 &pcfg_pull_none>,
				<3 RK_PD1 1 &pcfg_pull_none>,
				<3 RK_PD2 1 &pcfg_pull_none>,
				<3 RK_PD3 1 &pcfg_pull_none>,
				<3 RK_PD4 1 &pcfg_pull_none>,
				<3 RK_PD5 1 &pcfg_pull_none>,
				<3 RK_PD6 1 &pcfg_pull_none>,
				<4 RK_PB0 1 &pcfg_pull_none>,
				<4 RK_PB1 1 &pcfg_pull_none>,
				<4 RK_PB3 1 &pcfg_pull_none>,
				<3 RK_PD7 1 &pcfg_pull_none>,
				<4 RK_PA0 1 &pcfg_pull_none>,
				<4 RK_PA1 1 &pcfg_pull_none>,
				<4 RK_PA2 1 &pcfg_pull_none>,
				<4 RK_PA3 1 &pcfg_pull_none>,
				<4 RK_PB6 1 &pcfg_pull_none>,
				<4 RK_PB4 1 &pcfg_pull_none>,
				<4 RK_PB5 1 &pcfg_pull_none>;
		};
	};

	buttons {
		ngp_gpio_key_pin: ngp-gpio-key-pin {
			rockchip,pins =
				<1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
				<2 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
				<2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		ngp_moto_gpio: ngp-moto-gpio {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	headphone {
		/* Stock board detects headphones on RK_PA6, not RK_PA7. */
		hp_det: hp-det {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	/*
	 * 原来这里有一组 charge-led 的 pin 配置：
	 *
	 *     ngp_charge_led_gpio: rockchip,pins =
	 *         <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>,
	 *         <3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>;
	 *
	 * 它把状态灯的两根线（C1 蓝 / C2 红）配成内部上拉，等于一直给
	 * LED 供电，于是「电源灯充电灯长期亮着，息屏也亮着」。
	 *
	 * 原厂 EmuELEC 的 DTS 里压根没有这组 pin，这些脚交给 rk817 硬件
	 * 自己按 CHG_STS 驱动即可。整组删掉，别再加回来。
	 */

	lcd {
		ngp_lcd_pwren: ngp-lcd-pwren {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	/*
	 * 摇杆灯（WS2812）走 SPI0，只要 MOSI + CLK 两根线。
	 * 引脚取自 AURKNIX/ROCKNIX 同款设备的 quirk（spi0m1-pins-ngp45h）：
	 * GPIO3_B5 与 GPIO3_B4。
	 *
	 * 故意不接 CS：AURKNIX 那组里的 CS 是 GPIO3_B7，而这根脚在本机同时是
	 * i2c4（板上挂 rk628 HDMI 桥）的 SDA —— spi 一抢，i2c-4 就注册不上，
	 * HDMI 直接废掉。WS2812 根本没有 CS，所以不要它。
	 */
	spi0-ngp45h {
		ngp_spi0_pins: spi0m1-pins-ngp45h {
			rockchip,pins =
				<3 RK_PB5 4 &pcfg_pull_none>,
				<3 RK_PB4 4 &pcfg_pull_none>;
		};
	};

	usb {
		usb_host_pwren: usb-host-pwren {
			rockchip,pins = <3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usb_otg_pwren: usb-otg-pwren {
			rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/* ---- Stick RGB rings: WS2812 chains on SPI0 ----------------------------- *
 *
 * The two rings are WS2812 (not an MCU), eight LEDs per ring, driven by
 * bit-banging them onto the SPI MOSI line at 8 MHz: one SPI byte per WS2812
 * bit, 0xC0 = '0', 0xFC = '1', GRB order.  Userspace is ws2812-common from
 * ROCKNIX/AURKNIX, invoked as
 *     ws2812-common --device /dev/spidev0.0 <mode>
 * via /usr/bin/analog_sticks_ledcontrol_single, started by
 * ngp-stickled.service.  spidev is therefore mandatory, not optional: with
 * SPI0 off there is no /dev/spidev0.0 and the rings stay dark no matter what
 * userspace does.
 *
 * spi-max-frequency must stay 8000000 -- it *is* the WS2812 bit clock
 * (1 byte = 1 bit), so a different rate changes the waveform and the strips
 * either miss frames or latch garbage.
 *
 * No CS and no MISO: WS2812 has neither, and GPIO3_B7 (the CS an AURKNIX
 * quirk would use) is i2c4's SDA on this board -- SPI claiming it kills
 * i2c-4 and with it the RK628D HDMI bridge.
 */
&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&ngp_spi0_pins>;

	spi_dev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};
